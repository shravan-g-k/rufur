# RUFUR secrets. Read fresh on every model call, so edits here apply without a restart.

# Groq keys, tried in order. A key that hits its DAILY limit is parked until it resets and the next one
# takes over. A per-minute rate limit doesn't switch keys: that call falls back to local Ollama instead.
GROQ_API_KEY=gsk_...
# More keys: comma-separated on one line...
GROQ_API_KEYS=
# ...or one per line, numbered:
# GROQ_API_KEY_1=gsk_...
# GROQ_API_KEY_2=gsk_...
